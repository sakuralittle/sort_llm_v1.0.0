# ============================================================
#  公文分辦 — Apache 設定
#  讓本資料夾可在 XAMPP htdocs 下安全運作
#  訪問入口：https://<host>/<本資料夾>/  → index.php
# ============================================================

DirectoryIndex index.php
Options -Indexes -MultiViews

# ---- IP 白名單：僅允許指定網段連線 ----
# 允許：
#   163.22.186.0/24       （校內公開網段）
#   192.168.0.0/16        （內網；註：原本寫 192.168.1.0/16，依 CIDR 實際生效範圍為 192.168.0.0/16）
#   127.0.0.1 / ::1       （本機，方便伺服器端測試；不需要可刪除）
<RequireAny>
    Require ip 163.22.186.0/24
    Require ip 192.168.0.0/16
    Require ip 127.0.0.1
    Require ip ::1
</RequireAny>

# ---- 阻擋直接存取設定檔（含 DB 密碼）----
<Files "config.php">
    Require all denied
</Files>

# ---- 阻擋備份／暫存檔 ----
<FilesMatch "\.(php~|bak|swp|orig|inc)$">
    Require all denied
</FilesMatch>

# ---- 阻擋 data / logs 目錄（執行時自動建立）----
RewriteEngine On
RewriteRule ^(data|logs)(/|$) - [F,L]

# ---- 阻擋 .bat 被當靜態檔下載 ----
<FilesMatch "\.(bat|cmd|sh)$">
    Require all denied
</FilesMatch>
